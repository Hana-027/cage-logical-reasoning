% Minimal local NeurIPS 2026 style shim for course submission compilation.
% Supports the template interface used by neurips_2026.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/01/01 Minimal NeurIPS 2026 compatible style]

\newif\if@neuripsfinal
\newif\if@neuripspreprint
\DeclareOption{final}{\@neuripsfinaltrue}
\DeclareOption{preprint}{\@neuripspreprinttrue}
\DeclareOption{main}{}
\DeclareOption{position}{}
\DeclareOption{eandd}{}
\DeclareOption{creativeai}{}
\DeclareOption{sglblindworkshop}{}
\DeclareOption{dblblindworkshop}{}
\DeclareOption{education}{}
\DeclareOption{nonatbib}{}
\ProcessOptions\relax

\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{times}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{abstract}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}
\setlength{\abovecaptionskip}{4pt}
\setlength{\belowcaptionskip}{-2pt}
\renewcommand{\abstractnamefont}{\normalfont\bfseries\centering}
\renewcommand{\abstracttextfont}{\normalfont\small}

\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{0.6em}{}
\titleformat{\paragraph}[runin]{\normalsize\bfseries}{ }{0em}{}[.]
\titlespacing*{\section}{0pt}{1.2ex plus .3ex minus .2ex}{0.7ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.0ex plus .2ex minus .2ex}{0.5ex plus .2ex}
\titlespacing*{\paragraph}{0pt}{0.6ex plus .2ex minus .2ex}{0.6em}

\pagestyle{fancy}
\fancyhf{}
\if@neuripsfinal
  \lhead{Meta-cognitive Proof Strategy Search for Logical Reasoning}
\else\if@neuripspreprint
  \lhead{Preprint. Work in progress.}
\else
  \lhead{Submitted to NeurIPS 2026. Do not distribute.}
\fi\fi
\cfoot{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\newcommand{\workshoptitle}[1]{}
\newenvironment{ack}{\par\section*{Acknowledgments}}{\par}

\renewcommand{\maketitle}{%
  \begin{center}%
    \hrule height 4pt\vskip 0.25in%
    {\LARGE\bfseries \@title \par}%
    \vskip 0.25in\hrule height 1pt\vskip 0.35in%
    \if@neuripsfinal
      {\large \@author \par}%
    \else\if@neuripspreprint
      {\large \@author \par}%
    \else
      {\large Anonymous Authors \par}%
    \fi\fi
  \end{center}%
  \vskip 0.4in%
}
